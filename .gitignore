# ──────────────────────────────────────────
# 隐盾安全智能体 · 忽略规则
# 原则：运行时状态、构建产物、大体积成片一律不入库；源码/文档/证据文件入库。
# ──────────────────────────────────────────

# 环境与缓存
secure_env/
__pycache__/
*.pyc
.cursor/
.vscode/
.tools/
.workbuddy/
.mimosa/

# 控制面运行时数据（SQLite 库、管理令牌明文文件；V3.5.0）
control_data/

# ── 运行时状态（每台机器不同，不入库）──
# 注意：这里逐项列出，不再使用 *.json 全局通配——
#       全局通配会连"应当入库的 JSON"（如评测结果证据）一起静默忽略。
/global_config.json
/chat_sessions.json
/config/
/audit_logs/
/data/
/yindun/data/
/yindun/cache/
test_kb_data/
test_kb_docs/
workflow_reports/
# 数据处理类工作流步骤的产物（归一化 JSON / 清洗后 CSV / 分析报告 / 图表 SVG）
workflow_outputs/
# 工作流实例的持久化快照（运行时状态：审批链/执行进度，随重启恢复）
/workflow_instances.json
# 插件数据目录（词表等由用户在本机编辑，属运行时状态）
/plugins_data/
# 运行日志（V3.6.1：logs/yindun.log，按 2MB × 3 份轮转；运行时状态，不入库）
/logs/
客户信息.txt
演示记录.txt
tunnel.bat

# ── 构建/打包产物（走 Release 附件分发，不入库）──
build/
dist/
*.spec.bak
*.manifest
*.exe
隐盾安全智能体_V*_安装包.exe

# ── 大体积成片（走 Release 分发）──
*.mp4
product-video/

# ── 备份与临时文件 ──
*.bak
~$*
*_new.pptx

# ── 第三方资料/研究素材（非本项目产物；含未发表稿件，勿入库）──
论文研究/

# 归档：历史证据/备份（不外发，也不入语言统计）
archive/

# ZCode 客户端本地忽略文件（内容与 .gitignore 同步，属客户端配置不入库）
.zcodeignore
