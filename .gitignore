# ──────────────────────────────────────────
# 隐盾安全智能体 · 忽略规则
# 原则：运行时状态、构建产物、大体积成片一律不入库；源码/文档/证据文件入库。
# ──────────────────────────────────────────

# 环境与缓存
secure_env/
__pycache__/
*.pyc
.cursor/
.vscode/
.tools/
.workbuddy/
.mimosa/

# 控制面运行时数据（SQLite 库、管理令牌明文文件；V3.5.0）
control_data/

# ── 运行时状态（每台机器不同，不入库）──
# 注意：这里逐项列出，不再使用 *.json 全局通配——
#       全局通配会连"应当入库的 JSON"（如评测结果证据）一起静默忽略。
/global_config.json
/chat_sessions.json
/config/
/audit_logs/
/data/
/yindun/data/
/yindun/cache/
test_kb_data/
test_kb_docs/
workflow_reports/
# 数据处理类工作流步骤的产物（归一化 JSON / 清洗后 CSV / 分析报告 / 图表 SVG）
workflow_outputs/
# 工作流实例的持久化快照（运行时状态：审批链/执行进度，随重启恢复）
/workflow_instances.json
# 插件数据目录（词表等由用户在本机编辑，属运行时状态）
/plugins_data/
# 运行日志（V3.6.1：logs/yindun.log，按 2MB × 3 份轮转；运行时状态，不入库）
/logs/
客户信息.txt
演示记录.txt
tunnel.bat

# ── 构建/打包产物（走 Release 附件分发，不入库）──
build/
dist/
*.spec.bak
*.manifest
*.exe
隐盾安全智能体_V*_安装包.exe

# ── 大体积成片（走 Release 分发）──
*.mp4
product-video/

# 组内视频制作协作：8 段 1080P 原片随仓库同步（单文件均 < 100MB，总计约 72MB）
# 例外：assets/介绍视频.mp4（171MB）超过 GitHub 单文件 100MB 限制，仍走旧 Release，不入库
!assets/视频素材/MP4原片/*.mp4

# ── 备份与临时文件 ──
*.bak
~$*
*_new.pptx
*_backup.pptx

# ── 第三方资料/研究素材（非本项目产物；含未发表稿件，勿入库）──
论文研究/

# 归档：历史证据/备份（不外发，也不入语言统计）
archive/

# 根目录录屏原片：正式资产统一放 docs/formal_assets/，原片不入库（避免重复占仓）
/*.gif

# ZCode 客户端本地忽略文件（内容与 .gitignore 同步，属客户端配置不入库）
.zcodeignore

# ppt-master 预览产物（工具自动生成，不入库）
.preview/

# 交付打包物（按需本地生成，不入库）
*.zip

# 内部过程稿与 AI 协作约定（不随公开仓库发布；本地保留）
docs/dev/
AGENTS.md
